{
  "info": {
    "_postman_id": "fraudvault-api-collection",
    "name": "FraudVault API",
    "description": "FraudVault document and image forgery detection API.\n\n## Recommended test flow\n1. Health Check\n2. Register (or Login)\n3. Create API Key\n4. Detect (Sync) — upload a .jpg or .pdf\n5. Detect (Async) — requires Celery worker, then Get Result\n6. Detect (API Key) — uses X-API-Key header\n7. Get Usage\n8. List Keys / Delete Key\n\n## Notes\n- Async detect requires: `celery -A app.workers.celery_app worker --loglevel=info`\n- Sync detect works with the API server only\n- Register/Login auto-save `access_token` and `refresh_token`\n- Create API Key auto-saves `api_key` and `key_id`\n- Detect requests auto-save `job_id`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "api_key", "value": "" },
    { "key": "key_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "test_email", "value": "test@example.com" },
    { "key": "test_password", "value": "securepass123" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Confirm the API server is running."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status is ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"full_name\": \"Postman Test User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "register"]
            },
            "description": "Register a new user. Auto-saves access_token and refresh_token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', res.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.refresh_token);",
                  "    pm.test('Tokens saved', function () {",
                  "        pm.expect(res.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Login with existing credentials. Auto-saves access_token and refresh_token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', res.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.refresh_token);",
                  "    pm.test('Tokens saved', function () {",
                  "        pm.expect(res.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "refresh"]
            },
            "description": "Refresh access token. Auto-saves new access_token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', pm.response.json().access_token);",
                  "    pm.test('Access token refreshed', function () {",
                  "        pm.expect(pm.collectionVariables.get('access_token')).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Detection",
      "item": [
        {
          "name": "Detect (Sync)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a .jpg, .png, .webp, .pdf, .heic, or .tiff file"
                },
                {
                  "key": "async_mode",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/detect",
              "host": ["{{base_url}}"],
              "path": ["v1", "detect"]
            },
            "description": "Upload a file and wait for synchronous detection result. Uses JWT Bearer auth. Select a file in the Body tab."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.job_id) {",
                  "        pm.collectionVariables.set('job_id', res.job_id);",
                  "    }",
                  "    pm.test('Detection completed', function () {",
                  "        pm.expect(res.status).to.eql('completed');",
                  "        pm.expect(res.verdict).to.be.oneOf(['authentic', 'tampered', 'ai_generated', 'inconclusive']);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Detect (Async)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a .jpg, .png, .webp, .pdf, .heic, or .tiff file"
                },
                {
                  "key": "async_mode",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "webhook_url",
                  "value": "",
                  "type": "text",
                  "description": "Optional webhook URL called on completion",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/detect",
              "host": ["{{base_url}}"],
              "path": ["v1", "detect"]
            },
            "description": "Queue detection job and return job_id immediately. Requires Celery worker. Poll with Get Result."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('job_id', res.job_id);",
                  "    pm.test('Job queued', function () {",
                  "        pm.expect(res.status).to.eql('queued');",
                  "        pm.expect(res.job_id).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Detect (API Key)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a .jpg, .png, .webp, .pdf, .heic, or .tiff file"
                },
                {
                  "key": "async_mode",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/detect",
              "host": ["{{base_url}}"],
              "path": ["v1", "detect"]
            },
            "description": "Detect using API key auth (X-API-Key header). Run Create API Key first."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.job_id) {",
                  "        pm.collectionVariables.set('job_id', res.job_id);",
                  "    }",
                  "    pm.test('Detection completed via API key', function () {",
                  "        pm.expect(res.status).to.eql('completed');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/results/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "results", "{{job_id}}"]
            },
            "description": "Poll async detection job result. Uses job_id saved from Detect (Async)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Has job status', function () {",
                  "    pm.expect(res.status).to.be.oneOf(['queued', 'processing', 'completed', 'failed']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Key\",\n  \"environment\": \"test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/keys",
              "host": ["{{base_url}}"],
              "path": ["v1", "keys"]
            },
            "description": "Create a new API key. Raw key returned once only. Auto-saves api_key and key_id."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('api_key', res.key);",
                  "    pm.collectionVariables.set('key_id', res.id);",
                  "    pm.test('API key saved', function () {",
                  "        pm.expect(res.key).to.match(/^fv_/);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/keys",
              "host": ["{{base_url}}"],
              "path": ["v1", "keys"]
            },
            "description": "List all active API keys. Raw keys are never returned."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/keys/{{key_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "keys", "{{key_id}}"]
            },
            "description": "Deactivate an API key. Uses key_id saved from Create API Key."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usage",
      "item": [
        {
          "name": "Get Usage (JWT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/usage",
              "host": ["{{base_url}}"],
              "path": ["v1", "usage"]
            },
            "description": "Get hit count breakdown for current billing period using JWT."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Has usage fields', function () {",
                  "    pm.expect(res).to.have.property('total_hits');",
                  "    pm.expect(res).to.have.property('by_type');",
                  "    pm.expect(res).to.have.property('by_key');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Usage (API Key)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/usage",
              "host": ["{{base_url}}"],
              "path": ["v1", "usage"]
            },
            "description": "Get usage stats using API key auth."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Stripe Webhook (subscription.updated)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Stripe-Signature",
                "value": "",
                "description": "Required in production. Leave empty when STRIPE_WEBHOOK_SECRET is unset.",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"customer.subscription.updated\",\n  \"data\": {\n    \"object\": {\n      \"customer\": \"cus_test123\",\n      \"items\": {\n        \"data\": [\n          {\n            \"price\": {\n              \"lookup_key\": \"starter\"\n            }\n          }\n        ]\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/webhooks/stripe",
              "host": ["{{base_url}}"],
              "path": ["v1", "webhooks", "stripe"]
            },
            "description": "Simulate Stripe customer.subscription.updated webhook. Works without signature when STRIPE_WEBHOOK_SECRET is not set in .env."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Received', function () {",
                  "    pm.expect(pm.response.json().received).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Stripe Webhook (subscription.deleted)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"customer.subscription.deleted\",\n  \"data\": {\n    \"object\": {\n      \"customer\": \"cus_test123\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/webhooks/stripe",
              "host": ["{{base_url}}"],
              "path": ["v1", "webhooks", "stripe"]
            },
            "description": "Simulate Stripe customer.subscription.deleted — downgrades user to free plan."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Stripe Webhook (invoice.payment_failed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"invoice.payment_failed\",\n  \"data\": {\n    \"object\": {\n      \"customer\": \"cus_test123\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/webhooks/stripe",
              "host": ["{{base_url}}"],
              "path": ["v1", "webhooks", "stripe"]
            },
            "description": "Simulate Stripe invoice.payment_failed — deactivates user and API keys."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
