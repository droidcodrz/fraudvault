# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_in_production_minimum_32_chars

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fraudvault:password@localhost:5432/fraudvault
DATABASE_SYNC_URL=postgresql://fraudvault:password@localhost:5432/fraudvault

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Stripe (optional) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudflare R2 Storage (optional, uses local storage if empty) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fraudvault-files

# ── SMTP (optional, logs emails in dev mode if empty) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fraudvault.io
SMTP_FROM_NAME=FraudVault
APP_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=*

# ── File limits ──────────────────────────────────────
MAX_FILE_SIZE_MB=50
